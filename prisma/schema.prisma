generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum MentorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum QuestionVisibility {
  PRIVATE
  PUBLIC
}

enum ModerationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum QuestionStatus {
  AWAITING_RESPONSE
  ANSWERED
  CLOSED
}

enum QuestionCategory {
  BOARD_EXAMS
  WELLNESS_BURNOUT
  CLINICAL_ROTATIONS
  CLINICAL_SKILLS
  RESIDENCY_MATCH
  ACADEMICS
  CAREER
  RESEARCH
  STUDY_SKILLS
  OTHER
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  MISINFORMATION
  PRIVACY
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  PENDING
  DISMISSED
  ACTION_TAKEN
}

model User {
  id                String     @id @default(cuid())
  email             String
  name              String?
  role              Role       @default(STUDENT)
  mentorStatus      MentorStatus @default(NONE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  assignedMentorId  String?
  assignedMentor    User?      @relation("MentorStudents", fields: [assignedMentorId], references: [id])
  assignedStudents  User[]     @relation("MentorStudents")

  questions         Question[] @relation("StudentQuestions")
  mentorQuestions   Question[] @relation("MentorQuestions")
  answers           Answer[]
  boosts            QuestionBoost[]
  notifications     Notification[]
  sentMessages      Message[]  @relation("SentMessages")
  receivedMessages  Message[]  @relation("ReceivedMessages")
  reportsMade       QuestionReport[] @relation("QuestionReportsMade")
  reportsReviewed   QuestionReport[] @relation("QuestionReportsReviewed")

  @@unique([email, role])
  @@index([email])
  @@index([role])
  @@index([assignedMentorId])
}

model Question {
  id                String             @id @default(cuid())
  title             String
  content           String
  category          QuestionCategory   @default(OTHER)
  visibility        QuestionVisibility @default(PRIVATE)
  isAnonymous       Boolean            @default(false)
  status            QuestionStatus     @default(AWAITING_RESPONSE)
  moderationStatus  ModerationStatus   @default(NOT_REQUIRED)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  studentId         String
  student            User               @relation("StudentQuestions", fields: [studentId], references: [id])

  mentorId          String?
  mentor            User?              @relation("MentorQuestions", fields: [mentorId], references: [id])

  answers           Answer[]
  boosts            QuestionBoost[]
  reports           QuestionReport[]

  @@index([studentId])
  @@index([mentorId])
  @@index([status])
  @@index([visibility, moderationStatus])
  @@index([createdAt])
}

model Answer {
  id          String   @id @default(cuid())
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  mentorId    String
  mentor      User     @relation(fields: [mentorId], references: [id])

  @@index([questionId])
  @@index([mentorId])
}

model QuestionBoost {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([questionId])
  @@index([userId])
}

model Message {
  id          String    @id @default(cuid())
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  readAt      DateTime?

  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model QuestionReport {
  id           String       @id @default(cuid())
  reason       ReportReason
  details      String?
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reviewedAt   DateTime?

  questionId   String
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  reporterId   String
  reporter     User         @relation("QuestionReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?        @relation("QuestionReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([questionId, reporterId])
  @@index([questionId, status])
  @@index([reporterId])
  @@index([status, createdAt])
}
